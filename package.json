{
  "name": "doctor-records",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "node scripts/native.mjs ios",
    "android": "node scripts/native.mjs android",
    "typecheck": "tsc --noEmit && tsc -p services/analytics/tsconfig.json",
    "test": "jest --runInBand",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:analytics",
    "e2e:ios": "node scripts/e2e.mjs ios",
    "e2e:android": "node scripts/e2e.mjs android",
    "check:env": "node scripts/check-env.mjs",
    "check:bundles": "expo export --platform ios --platform android --output-dir tmp/bundle-check",
    "analytics:dev": "node --experimental-strip-types services/analytics/server.ts",
    "test:analytics": "node --experimental-strip-types --test services/analytics/server.test.ts",
    "lint": "eslint app src modules/local-pdf/index.ts services scripts --max-warnings 0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "decimal.js": "10.6.0",
    "expo": "54.0.38",
    "expo-asset": "~12.0.14",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "3.6.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
